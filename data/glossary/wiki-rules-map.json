[
  {"blocker": "Burst", "match": "^Burst|wiki template \\{\\{Burst\\}\\}|^Burst condition", "sources": [["Burst", ""], ["Comprehensive Rules/Categories of Effects", "Burst Activation"], ["Comprehensive Rules/Categories of Effects", "\"After Your Burst Activates\""]], "note": "engine: docs/mechanics/burst-order.md"},
  {"blocker": "no trigger: (Your Attack Step)", "match": "^no trigger: \\((?:Your|Opposing|Either) (?:Attack|Main|End|Draw|Start|Core|Refresh) Step\\)|^no trigger: \\(Start of Your Attack Step\\)", "sources": [["Comprehensive Rules/Categories of Effects", "Effects Which Activate During Specific Steps"], ["Comprehensive Rules/Categories of Effects", "\"At the Beginning of the Step\"/\"At the End of the Step\""], ["Official Rule Manual (Standard)", "Turn Procedures"]], "note": "step timing heads: docs/mechanics/step-timings.md"},
  {"blocker": "no trigger: Flash - (Either", "match": "^no trigger: Flash - ", "sources": [["Comprehensive Rules/Categories of Effects", "Effects Which Activate During Specific Steps"], ["Comprehensive Rules/Categories of Effects", "Interruptive Effects"]], "note": "a step head usable only in a Flash timing of that step"},
  {"blocker": "no trigger: (During Your Battle Phase)", "match": "^no trigger: \\(During Your Battle Phase\\)", "sources": [["Comprehensive Rules/Categories of Effects", "Effects Which Activate During Specific Steps"]], "note": "Standard wording of the Attack Step period"},
  {"blocker": "no trigger: (Your Turn)", "match": "^no trigger: \\((?:Your|Opposing) Turn\\)", "sources": [["Comprehensive Rules/Categories of Effects", "Constant Effects"]], "note": "constant effect limited to a turn owner"},
  {"blocker": "no trigger: While you control", "match": "^no trigger: While |^no trigger: \\(Permanent\\)", "sources": [["Comprehensive Rules/Categories of Effects", "Constant Effects"]], "note": "conditional constant effect"},
  {"blocker": "sentence: During this", "match": "^sentence: during this", "sources": [["Comprehensive Rules/Categories of Effects", "\"During This...\""], ["Comprehensive Rules/Categories of Effects", "\"At the End of...\""]], "note": "duration: lasts after the source leaves; ends after End Step effects"},
  {"blocker": "sentence: also, if", "match": "^sentence: (?:also|then)", "sources": [["Comprehensive Rules/Categories of Effects", "\"Also\", \"Then\", and \"After the Effect Resolves\""]], "note": "connectives"},
  {"blocker": "no trigger: (Once per Turn: Same Name)", "match": "once per turn|\\(once per", "sources": [["Comprehensive Rules/Categories of Effects", "\"(Once Per Turn: Same Name)\" and \"Once Per Turn, ...\""]], "note": "Same Name = per effect name; embedded 'once per turn,' = per card"},
  {"blocker": "sentence: by discarding a", "match": "^sentence: by (?:discarding|sending|exhausting|returning|putting)", "sources": [["Comprehensive Rules/Effect Texts", "\"By doing A, do B\" (～することで、～する)"]], "note": "cost-like clause: B only when A was done"},
  {"blocker": "v2 reveal: no \"remaining cards\" ending", "match": "remaining cards|^sentence: reveal", "sources": [["Comprehensive Rules/Effect Texts", "\"Remaining Cards\" & \"Otherwise\" (「残ったカード」と「それ以外」/「他のカード」)"], ["Comprehensive Rules/Other Explanations of Rules", "Revealed Cards"]], "note": "where the rest of a reveal goes"},
  {"blocker": "sentence: when only the", "match": "^sentence: when only|^no trigger: \\(When Battles\\)", "sources": [["Comprehensive Rules/Categories of Effects", "Spirits' \"When Attacks/Blocks\" Effects"]], "note": "battle-win wording"},
  {"blocker": "no trigger: (When Deployed)", "match": "^no trigger: \\(When (?:Deployed|Summoned)\\)|^no trigger: When summoning this", "sources": [["Comprehensive Rules/Categories of Effects", "\"When Summoned/[[Advent|Advents]]\" Effects and \"When Deployed\" Effects"], ["Comprehensive Rules/Categories of Effects", "Summoning or Deploying via Effects"]], "note": ""},
  {"blocker": "no trigger: (When Depleted/Destroyed by the Opponent)", "match": "Depleted|^no trigger: When this Spirit|^no trigger: When this card", "sources": [["Comprehensive Rules/Depletion", "When Spirits/Ultimates are Depleted by the Opponent"], ["Comprehensive Rules/Categories of Effects", "Spirit/Nexus' \"When Destroyed\" Effects"], ["Comprehensive Rules/Destruction", "Resolving Destruction"]], "note": ""},
  {"blocker": "v2 destroy: filter other", "match": "^v2 destroy|^sentence: destroy", "sources": [["Comprehensive Rules/Destruction", "Resolving Destruction"], ["Comprehensive Rules/Effect Texts", "Targets of Effects"]], "note": ""},
  {"blocker": "sentence: target an opposing", "match": "^sentence: target", "sources": [["Comprehensive Rules/Effect Texts", "Targets of Effects"], ["Comprehensive Rules/Effect Texts", "Do as Much as Possible"]], "note": ""},
  {"blocker": "sentence: if you control", "match": "^sentence: if ", "sources": [["Comprehensive Rules/Effect Texts", "Do as Much as Possible"]], "note": "condition checked when the effect resolves"},
  {"blocker": "Armor text", "match": "Armor|unaffected", "sources": [["Armor (Keyword)", ""], ["Comprehensive Rules/Effect Texts", "\"Unaffected by Effects\" Effects (効果を受けない)"]], "note": "engine: docs/mechanics/effect-priority-unaffected.md"},
  {"blocker": "no trigger: Cards can't be", "match": "can't|cannot", "sources": [["Comprehensive Rules/Effect Texts", "Denial Effects (～できない)"]], "note": "denial effects"},
